{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masslens-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "OPENAI_REASONING_EFFORT": "medium",
    "BILLING_ENFORCED": "false",
    "GOOGLE_PLAY_PACKAGE_NAME": "com.lilai.aivirtual",
    "ADMOB_REWARDED_AD_UNIT_ID": ""
  },
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masslens-billing",
      "database_id": "b4b1f8e6-a2f5-4adb-88fe-d77cc2d38de7"
    }
  ],
  "observability": {
    "enabled": true
  }
}
