{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masslens-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5-nano",
    "OPENAI_REASONING_EFFORT": "minimal",
    "OPENAI_MAX_OUTPUT_TOKENS": "800",
    "SCAN_ACCESS_ENFORCED": "true",
    "MAX_DAILY_AI_COST_MICROS": "5000000",
    "INTERSTITIAL_EVERY": "2",
    "INTERSTITIAL_COOLDOWN_SECONDS": "180",
    "APP_OPEN_COOLDOWN_SECONDS": "14400",
    "ADMOB_REWARDED_AD_UNIT_ID": "ca-app-pub-7681170430097585/3756662851"
  },
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masslens-billing",
      "database_id": "b4b1f8e6-a2f5-4adb-88fe-d77cc2d38de7"
    }
  ],
  "observability": {
    "enabled": true
  }
}
